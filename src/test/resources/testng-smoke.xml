<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-commerce Smoke">
    <listeners>
        <listener class-name="com.qa.shop.listeners.RetryTransformer"/>
    </listeners>
    <test name="Smoke" parallel="methods" thread-count="3">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.qa.shop.tests.api"/>
            <package name="com.qa.shop.tests.ui"/>
            <package name="com.qa.shop.tests.e2e"/>
        </packages>
    </test>
</suite>
