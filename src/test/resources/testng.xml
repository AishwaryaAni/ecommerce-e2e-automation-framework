<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-commerce Regression">
    <listeners>
        <listener class-name="com.qa.shop.listeners.RetryTransformer"/>
    </listeners>

    <!-- Fast, deterministic layer first: if the API is down, the report shows it immediately -->
    <test name="API" parallel="methods" thread-count="4">
        <packages>
            <package name="com.qa.shop.tests.api"/>
        </packages>
    </test>

    <test name="UI and End-to-End" parallel="methods" thread-count="3" data-provider-thread-count="2">
        <packages>
            <package name="com.qa.shop.tests.ui"/>
            <package name="com.qa.shop.tests.e2e"/>
        </packages>
    </test>
</suite>
